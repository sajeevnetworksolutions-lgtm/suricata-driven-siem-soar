# =============================================================================
# Suricata SIEM + SOAR Platform - Environment Configuration
# Copy this file to .env and customize values as needed.
# =============================================================================

# --- General System Settings ---
PROJECT_NAME="suricata-driven-siem-soar"
ENVIRONMENT="production" # production | development | lab
LOG_LEVEL="INFO"         # DEBUG | INFO | WARNING | ERROR

# --- Suricata Sensor Configuration ---
SURICATA_INTERFACE="eth0"
EVE_LOG_PATH="/var/log/suricata/eve.json"
SURICATA_RULE_PATH="/var/lib/suricata/rules"

# --- Elastic Stack (SIEM) Settings ---
ELASTICSEARCH_URL="http://elasticsearch:9200"
KIBANA_URL="http://kibana:5601"
ES_JAVA_OPTS="-Xms512m -Xmx512m"
ELASTIC_VERSION="8.12.0"

# --- SOAR Automated Incident Response Policies ---
AUTO_BAN_ENABLED=true
BAN_THRESHOLD_SEVERITY=1        # 1 = Critical only, 2 = High & Critical
BAN_TTL_SECONDS=300             # Duration in seconds for dynamic IP quarantine cooling-off
WHITELISTED_IPS="127.0.0.1,10.0.0.1,172.28.0.1"

# --- Threat Intelligence Feeds (Optional API Keys) ---
# Register for free API keys at https://www.abuseipdb.com/ and https://www.virustotal.com/
ABUSEIPDB_API_KEY=""
VIRUSTOTAL_API_KEY=""

# --- SOC Alert Webhooks (Optional Integrations) ---
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""
PAGERDUTY_KEY=""

# --- Service Port Bindings ---
SOAR_PORT=8000
TARGET_PORT=8080
KIBANA_PORT=5601
ELASTICSEARCH_PORT=9200
TARGET_SSH_PORT=2222
