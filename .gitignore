# =============================================================================
# Git Ignore Configuration - Suricata SIEM + SOAR Platform
# =============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
env/
venv/
ENV/
.venv/

# Environment Variables & Secrets
.env
!.env.example
*.pem
*.key
*.crt

# Runtime Logs & Telemetry
logs/*.log
logs/*.json
!logs/.gitkeep
*.log

# Runtime Forensic Case Dossiers & SQLite/Audit Ledgers (Keep folder structure & sample)
soar_engine/data/forensics/*.json
soar_engine/data/forensics/*.jsonl
!soar_engine/data/forensics/sample_case_dossier.json
!soar_engine/data/forensics/.gitkeep
soar_engine/data/*.json
soar_engine/data/*.jsonl
soar_engine/data/*.db
!soar_engine/data/.gitkeep
.pytest_cache/

# Docker Volumes & Databases
es_data/
suricata_logs/

# Operating System Metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
