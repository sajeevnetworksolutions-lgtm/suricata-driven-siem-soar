# =============================================================================
# DNS THREATS & DNS TUNNELING DETECTION RULES
# MITRE ATT&CK: TA0010 (Exfiltration) / T1048.003 (DNS Tunneling)
# Severity: priority:1 -> triggers SOAR auto-quarantine (Eq. 8, 100% containment)
# =============================================================================

# 1. High-Entropy / Long Subdomain Query (Table II: DNS name > 50 B)
alert dns any any -> any 53 (msg:"SIEM-DNS: Potential DNS Data Exfiltration / Tunneling (Oversized Query Name)"; dns.query; isdataat:50,relative; classtype:bad-unknown; priority:1; sid:1000040; rev:2; metadata:mitre_tactic_id TA0010, mitre_technique_id T1048.003;)

# 2. Suspicious Base64 / Hex Encoded DNS Query Label
alert dns any any -> any 53 (msg:"SIEM-DNS: Encoded Data in DNS Request Header"; dns.query; pcre:"/^[a-zA-Z0-9+\/=]{30,}\./"; classtype:bad-unknown; priority:1; sid:1000041; rev:2; metadata:mitre_tactic_id TA0010, mitre_technique_id T1048.003;)

# 3. High Volume of DNS TXT Queries (Possible C2 / Data Channel)
alert dns any any -> any 53 (msg:"SIEM-DNS: High Rate of DNS TXT Record Queries (Possible C2/Exfil)"; threshold:type both, track by_src, count 15, seconds 5; classtype:bad-unknown; priority:1; sid:1000042; rev:2; metadata:mitre_tactic_id TA0011, mitre_technique_id T1071.004;)
